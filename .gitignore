# macOS
.DS_Store

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
# `.venv/` est le nom le plus courant aujourd'hui (uv, poetry, pipenv) et
# n'est PAS couvert par `venv/` ci-dessus : le motif ignore le point initial.
# Sans cette ligne, seul le `.gitignore` que `python -m venv` écrit DANS
# l'environnement protège `backend/app/services/llm_providers/.venv`
# (9 Mo) — et il disparaît si le venv est recréé autrement (copie, uv,
# --without-pip), ce qui exposerait tout l'arborescence au commit.
.venv/
.env
.env.*.local
.env.production

# Node
node_modules/

# Next.js
.next/
out/

# Playwright
test-results/
playwright-report/
playwright/.cache/

# Flutter / Dart
mobile/.dart_tool/
mobile/build/
mobile/.flutter-plugins-dependencies

# Environment files
frontend/.env.local
backend/.env

# IDE files
.vscode/
*.swp

# Package manager lock files
# keep package-lock.json and pubspec.lock under version control

# Misc
*.orig
backend/.venv/
backend/.coverage
backend/coverage.xml

# Local certs (self-signed for dev/testing)
certs/

frontend/tsconfig.tsbuildinfo
.last_git_pull
.idea/
.coverage
