# =============================================================================
# Production environment template — copy to .env.production and fill values.
#   cp .env.production.example .env.production
# NEVER commit .env.production (already gitignored).
# =============================================================================

# --- Runtime environment -----------------------------------------------------
# Must stay "production" for the deployed stack; the backend refuses to boot
# with an insecure SECRET_KEY only when this is "production" (app/config.py).
ENV=production

# --- Domains & TLS (Let's Encrypt) -------------------------------------------
# DNS A/AAAA records for BOTH hosts must point at the server before first boot.
DOMAIN=your-domain.com
API_DOMAIN=api.your-domain.com
# Certificate renewal notices + expiry alerts from Let's Encrypt.
ACME_EMAIL=you@your-domain.com
# Leave commented for real certificates. While testing DNS/TLS, uncomment the
# staging URL to avoid Let's Encrypt production rate limits:
# ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory

# --- Secrets (generate, never reuse dev values) ------------------------------
# JWT signing key:      openssl rand -hex 32
# The app REFUSES to start if this is empty or a known placeholder.
SECRET_KEY=
# Postgres superuser password inside the Docker network:  openssl rand -hex 24
DB_PASSWORD=
# Redis password (redis --requirepass):                   openssl rand -hex 24
REDIS_PASSWORD=

# --- Database ----------------------------------------------------------------
DB_USER=postgres
DB_NAME=discoverai

# --- LLM provider ------------------------------------------------------------
OPENAI_API_KEY=sk-...
LLM_PROVIDER=openai
OPENAI_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

# --- Optional ----------------------------------------------------------------
DEFAULT_TENANT_SLUG=algeria
