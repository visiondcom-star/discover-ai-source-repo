# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/discoverai

# Redis
REDIS_URL=redis://redis:6379/0

# Security
SECRET_KEY=change-me-in-production

# OpenAI (optional - AI features work without it via fallback)
OPENAI_API_KEY=sk-...

# Default tenant
DEFAULT_TENANT_SLUG=algeria

# Email & Notification Worker
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=notifications@discoverai.local
EMAIL_FROM_NAME=Discover AI
EMAIL_WORKER_ENABLED=false
EMAIL_WORKER_INTERVAL_SECONDS=15
EMAIL_BATCH_SIZE=20
EMAIL_HTTP_TIMEOUT_SECONDS=15
EMAIL_LOCK_SECONDS=600
